# Optional local overrides for docker compose.
# The default docker-compose.yml does not require this file.
#
# Prefer configuring site name/domain, AI providers, translation providers,
# SMTP, plans, and content rules in the admin dashboard so they are stored in
# the database and survive image rebuilds.
#
# If you need a different host port, edit docker-compose.yml directly or run:
#   docker compose -p z7rss -f docker-compose.yml ...
#
# Advanced examples, only add when your deployment needs them:
# APP_URL=https://rss.example.com
# TRUST_PROXY=true
# SESSION_COOKIE_SECURE=true
# ADMIN_EMAILS=admin@example.com
#
# Stripe still needs server-side secrets if you enable real billing:
# BILLING_PROVIDER=stripe
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
